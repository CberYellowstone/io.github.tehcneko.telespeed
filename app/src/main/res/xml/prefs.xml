<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference android:summary="@string/xposed_description" />

    <PreferenceCategory android:title="@string/settings">
        <ListPreference
            android:key="speed"
            android:title="@string/speed_level"
            android:summary="%s"
            android:entries="@array/boost_level"
            android:entryValues="@array/boost_value"
            android:defaultValue="average" />

        <CheckBoxPreference
            android:key="follow_neko"
            android:title="@string/follow_neko"
            android:summary="@string/follow_neko_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/about">

        <Preference
            android:key="version"
            android:title="@string/version" />

        <Preference
            android:title="Nekogram"
            android:summary="https://nekogram.app">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://nekogram.app" />
        </Preference>

        <Preference
            android:title="@string/source_code"
            android:summary="github.com/CberYellowstone/io.github.tehcneko.telespeed">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/CberYellowstone/io.github.tehcneko.telespeed" />
        </Preference>

    </PreferenceCategory>

</PreferenceScreen>
